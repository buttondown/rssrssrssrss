{
	"name": "rssrssrss",
	"version": 2,
	"builds": [
		{
			"src": "package.json",
			"use": "@vercel/next"
		}
	],
	"routes": [
		{
			"src": "/api/merge",
			"headers": {
				"Cache-Control": "public, max-age=600, s-maxage=3600, stale-while-revalidate=86400",
				"Content-Type": "application/rss+xml; charset=utf-8"
			}
		}
	],
	"github": {
		"silent": true
	}
}
